{
  "name": "production-desk",
  "version": "1.5.12",
  "description": "Offline film scheduling, script breakdowns and shot lists",
  "author": "Squid Productions",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.squidproductions.productiondesk",
    "productName": "Production Desk",
    "directories": {
      "output": "../../dist/windows",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "updates.cjs",
      "preload.cjs",
      "smoke.cjs",
      "package.json",
      "regressions.cjs",
      "lined-regressions.cjs",
      "lined-controls-regressions.cjs",
      "shot-navigation-regressions.cjs",
      "schedule-drag-regressions.cjs",
      "project-import-regressions.cjs",
      "support-regressions.cjs",
      "workspace-layout-regressions.cjs",
      "demo-regressions.cjs",
      "breakdown-editing-regressions.cjs",
      "script-pdf-regressions.cjs"
    ],
    "extraResources": [
      {
        "from": "../../build/windows/backend/ProductionDeskServer",
        "to": "backend"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "../release-notes.txt"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Production-Desk-Windows-Setup.exe",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/OfficialSquidProductions/production-desk-updates/releases/latest/download/"
      }
    ]
  }
}
